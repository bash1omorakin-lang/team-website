<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Leading Team | Music Sync Licensing Support for Independent Artists</title>
<meta name="description" content="Leading Team helps independent artists assess catalogues, prepare music and explore sync opportunities in film, TV and advertising. No placement guarantees; written approval first.">
<meta property="og:title" content="Leading Team | Music Sync Licensing Support for Independent Artists">
<meta property="og:description" content="Your music. Prepared for the screen. Catalogue review, sync-readiness and authorised submissions for independent artists.">
<meta property="og:type" content="website">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,800&family=Inter+Tight:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{--bg:#eef2ef;--ink:#0d2a24;--deep:#0a1f1a;--muted:#52695f;--soft:#b7cbc3;--line:#d3ddd7;--card:#fff;--accent:#f0b429;--ai:#2b2100;--display:'Bricolage Grotesque',Georgia,serif;--body:'Inter Tight',system-ui,sans-serif;--ease:cubic-bezier(.2,.7,.2,1)}
*{box-sizing:border-box;margin:0;padding:0}
[hidden]{display:none!important}
html{scroll-behavior:smooth}
body{font:17px/1.65 var(--body);background:var(--bg);color:var(--ink);overflow-x:hidden}
a{color:inherit;text-decoration:none}
:focus-visible{outline:3px solid var(--accent);outline-offset:3px}
.wrap{max-width:1120px;margin:0 auto;padding:0 24px}
h1,h2,h3{font-family:var(--display);line-height:1.04;letter-spacing:-.025em;font-weight:800}
h2{font-size:clamp(2.1rem,5vw,3.6rem);margin-bottom:18px}
.sec{padding:110px 0}
.lead{color:var(--muted);font-size:1.12rem;max-width:58ch}
.dark{background:var(--deep);color:#eaf2ee}.dark .lead{color:var(--soft)}
.n{font-family:var(--display);font-weight:800;color:var(--accent)}
.reveal{opacity:0}
.reveal.in{opacity:1;animation:rise .9s var(--ease) backwards;animation-delay:var(--d,0s)}
@keyframes rise{from{opacity:0;transform:translateY(32px)}}
.progress{position:fixed;top:0;left:0;height:3px;width:0;background:var(--accent);z-index:80}

/* header + popup menu */
.top{position:fixed;inset:0 0 auto;z-index:50;display:flex;justify-content:space-between;align-items:center;padding:18px 28px;color:#fff;mix-blend-mode:difference}
.logo{font-family:var(--display);font-weight:800;font-size:1.35rem}
.dots,.close{width:48px;height:48px;border-radius:50%;border:1.5px solid currentColor;background:none;color:inherit;cursor:pointer;display:grid;place-items:center;font-size:1.7rem;line-height:1;transition:transform .35s var(--ease)}
.dots:hover,.close:hover{transform:rotate(90deg) scale(1.08)}
.menu{position:fixed;inset:0;z-index:70;background:var(--deep);color:#eaf2ee;visibility:hidden;clip-path:circle(0 at calc(100% - 52px) 42px);transition:clip-path .7s var(--ease),visibility 0s .7s;overflow:auto}
.menu.open{visibility:visible;clip-path:circle(150% at calc(100% - 52px) 42px);transition:clip-path .7s var(--ease)}
.close{position:absolute;top:18px;right:28px}
.menu-inner{max-width:1120px;margin:0 auto;padding:130px 24px 40px;display:grid;grid-template-columns:1fr 1fr;gap:48px}
.m-label{color:var(--accent);font-weight:600;font-size:.95rem;margin-bottom:14px}
.menu li{list-style:none;overflow:hidden}
.menu li a{display:block;font-family:var(--display);font-weight:800;font-size:clamp(2rem,5vw,3.4rem);line-height:1.2;transform:translateY(110%);transition:transform .6s var(--ease),color .2s;transition-delay:calc(.25s + var(--i)*.06s)}
.menu.open li a{transform:none}
.menu li a:hover{color:var(--accent)}
#svcLinks a{font-size:clamp(1.2rem,3vw,1.8rem);font-weight:500}

/* hero */
.hero{position:relative;min-height:100vh;display:flex;flex-direction:column;justify-content:flex-end;overflow:hidden;padding-top:130px}
.blob{position:absolute;border-radius:50%;filter:blur(80px);animation:float 14s ease-in-out infinite alternate}
.b1{width:440px;height:440px;background:#1f6b57;opacity:.55;top:6%;right:-90px}
.b2{width:330px;height:330px;background:var(--accent);opacity:.25;bottom:28%;left:-110px;animation-delay:-6s}
@keyframes float{to{transform:translate(-40px,50px) scale(1.15)}}
.hero .wrap{position:relative}
.hero h1{font-size:clamp(3rem,10vw,8.2rem);max-width:12ch}
.w{display:inline-block;overflow:hidden;vertical-align:top;padding-bottom:.1em}
.w>span{display:inline-block;transform:translateY(110%);animation:up .9s var(--ease) forwards;animation-delay:calc(.2s + var(--i)*.09s)}
@keyframes up{to{transform:none}}
.hero .lead{margin-top:28px}
.cta{display:flex;gap:14px;flex-wrap:wrap;margin-top:34px}
.btn{display:inline-block;padding:15px 28px;border-radius:999px;font-weight:600;background:var(--accent);color:var(--ai);transition:transform .3s var(--ease),box-shadow .3s}
.btn:hover{transform:translateY(-3px);box-shadow:0 10px 30px rgba(240,180,41,.35)}
.btn.ghost{background:none;color:inherit;border:1.5px solid rgba(255,255,255,.35)}
.faces{display:flex;margin-top:40px}
.faces img{width:58px;height:58px;border-radius:50%;object-fit:cover;object-position:top;border:3px solid var(--deep);margin-left:-14px}
.faces img:first-child{margin-left:0}
.marquee{margin-top:64px;border-top:1px solid #1d3d34;overflow:hidden;white-space:nowrap;padding:18px 0;position:relative}
.marquee div{display:inline-block;animation:slide 30s linear infinite}
.marquee span{font-family:var(--display);font-size:1.5rem;color:var(--soft);margin-right:34px}
.marquee span::after{content:'\2726';color:var(--accent);margin-left:34px}
@keyframes slide{to{transform:translateX(-50%)}}

/* feature cards */
.grid{display:grid;grid-template-columns:repeat(6,1fr);gap:20px;margin-top:48px}
.card{grid-column:span 2;background:var(--card);border:1px solid var(--line);border-radius:22px;padding:30px;min-height:300px;display:flex;flex-direction:column;transition:transform .45s var(--ease),box-shadow .45s,background .45s,color .45s}
.card:nth-child(n+4){grid-column:span 3}
.card:hover{transform:translateY(-8px);box-shadow:0 24px 50px rgba(13,42,36,.16);background:var(--ink);color:#eaf2ee}
.card h3{font-size:1.9rem;margin:auto 0 10px;padding-top:40px}
.card p{color:var(--muted);transition:color .45s}.card:hover p{color:var(--soft)}
.more{margin-top:20px;font-weight:600;display:flex;align-items:center;gap:10px}
.more i{display:grid;place-items:center;width:36px;height:36px;border-radius:50%;background:var(--accent);color:var(--ai);font-style:normal;transition:transform .4s var(--ease)}
.card:hover .more i{transform:translateX(8px)}

/* about */
.stats{display:flex;flex-wrap:wrap;gap:56px;margin:44px 0 0}
.stats b{display:block;font-family:var(--display);font-size:clamp(3rem,7vw,5rem);color:var(--accent);line-height:1}
.stats span{color:var(--soft)}
.two{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:56px;margin-top:80px}
.two h3,.sub{font-size:1.6rem;color:var(--accent);margin-bottom:14px}
.two p{color:var(--soft);max-width:50ch}
.steps{list-style:none;display:grid;gap:18px}
.steps b{display:block}.steps span{color:var(--soft);font-size:.98rem}
.values{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:32px;border-top:1px solid #234a3f;padding-top:30px;margin-top:20px}
.values b{display:block;font-family:var(--display);font-size:1.25rem;margin-bottom:6px}
.values span{color:var(--soft);font-size:.96rem}

/* team */
.team{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:18px;margin-top:48px}
.person{position:relative;border-radius:20px;overflow:hidden;aspect-ratio:4/5;background:var(--ink);color:#fff;display:block}
.person img{width:100%;height:100%;object-fit:cover;object-position:top;filter:grayscale(.4);transition:transform .9s var(--ease),filter .5s}
.person:hover img,.person:focus-visible img{transform:scale(1.08);filter:none}
.info{position:absolute;inset:auto 0 0;padding:70px 18px 18px;background:linear-gradient(transparent,rgba(5,20,16,.94))}
.info h3{font-size:1.4rem}.info small{color:var(--accent);font-weight:600}
.info p{max-height:0;opacity:0;overflow:hidden;font-size:.92rem;line-height:1.45;transition:max-height .5s var(--ease),opacity .4s,margin .4s}
.person:hover .info p,.person:focus-visible .info p{max-height:110px;opacity:1;margin-top:8px}

/* faq + policy */
details{border-top:1px solid var(--line);padding:22px 0}
details:last-of-type{border-bottom:1px solid var(--line)}
.dark details{border-color:#234a3f}
summary{cursor:pointer;font-family:var(--display);font-size:1.3rem;list-style:none;display:flex;justify-content:space-between;gap:16px}
summary::-webkit-details-marker{display:none}
summary::after{content:'+';font-size:1.7rem;line-height:1;transition:transform .3s var(--ease)}
details[open] summary::after{transform:rotate(45deg)}
details p{margin-top:12px;color:var(--muted);max-width:62ch}.dark details p{color:var(--soft)}

/* service page */
.s-hero{padding:150px 0 90px}
.back{display:inline-block;margin-bottom:36px;color:var(--soft);font-weight:500}.back:hover{color:var(--accent)}
.s-hero h1{font-size:clamp(2.8rem,8vw,6.5rem);margin-top:6px}
.owner{display:flex;align-items:center;gap:14px;margin-top:34px;line-height:1.35}
.owner img{width:56px;height:56px;border-radius:50%;object-fit:cover;object-position:top}
.split{display:grid;grid-template-columns:1fr 1.4fr;gap:56px;align-items:start}
.split p{font-size:1.2rem}
.bgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:18px;margin-top:40px}
.bcard{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:28px;transition:transform .4s var(--ease)}
.bcard:hover{transform:translateY(-6px)}
.bcard h3{font-size:1.3rem;margin-bottom:8px}.bcard p{color:var(--muted);font-size:.98rem}
.checks{list-style:none;margin-top:30px}
.checks li{display:flex;gap:16px;padding:20px 0;border-top:1px solid #234a3f;font-size:1.15rem}
.checks li::before{content:'\2713';flex:none;display:grid;place-items:center;width:26px;height:26px;margin-top:3px;border-radius:50%;background:var(--accent);color:var(--ai);font-size:.85rem;font-weight:700}
.psteps{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:24px;margin-top:40px}
.pstep{border-top:2px solid var(--ink);padding-top:22px}
.pstep b{font-family:var(--display);font-size:2.6rem;color:var(--accent);display:block;line-height:1}
.pstep h3{font-size:1.3rem;margin:10px 0 6px}.pstep p{color:var(--muted);font-size:.97rem}
.chips{display:flex;flex-wrap:wrap;gap:10px;margin-top:20px}
.chips a{border:1.5px solid #2c5649;border-radius:999px;padding:9px 20px;font-weight:500;transition:background .3s,color .3s}
.chips a:hover{background:var(--accent);color:var(--ai);border-color:var(--accent)}
.eyebrow{color:var(--accent);font-weight:600;margin-bottom:18px}
.facts{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));margin-top:44px;border-top:1px solid #234a3f}
.facts div{padding:18px 18px 0 0}.facts small{color:var(--soft);display:block}.facts b{font-family:var(--display);font-size:1.15rem}
.nlist{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:28px;margin-top:44px}
.nitem{border-top:2px solid currentColor;padding-top:18px}
.nitem b{font-family:var(--display);color:var(--accent);font-size:1.1rem}
.nitem h3{font-size:1.35rem;margin:8px 0}.nitem p{color:var(--muted);font-size:.97rem}.dark .nitem p{color:var(--soft)}
.disc{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px;margin-top:28px}
.disc a{border:1px solid var(--line);border-radius:16px;padding:22px;background:var(--card);transition:transform .4s var(--ease),border-color .3s}
.disc a:hover{transform:translateY(-5px);border-color:var(--ink)}
.disc b{display:block;font-family:var(--display);font-size:1.2rem}.disc span{color:var(--muted);font-size:.95rem}.disc small{display:block;margin-top:10px;font-weight:600}
.tabs{display:flex;flex-wrap:wrap;gap:8px;margin:36px 0 12px}
.tab{border:1.5px solid var(--ink);background:none;color:inherit;border-radius:999px;padding:8px 18px;font:inherit;font-weight:500;cursor:pointer;transition:background .3s,color .3s}
.tab[aria-pressed="true"]{background:var(--ink);color:var(--bg)}
.ins{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:18px;margin-top:44px}
.art{border:1px solid #234a3f;border-radius:18px;padding:26px;display:flex;flex-direction:column;gap:10px}
.art:first-child{grid-column:1/-1;background:#12362d}
.art small{color:var(--accent);font-weight:600}.art h3{font-size:1.45rem}.art p{color:var(--soft);font-size:.97rem}.art em{font-style:normal;color:var(--soft);font-size:.88rem;margin-top:auto}
.fgrid{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:40px}
.fgrid h4{color:#eaf2ee;font-family:var(--display);margin-bottom:10px}
.fgrid li{list-style:none;margin:6px 0}.fgrid a:hover{color:var(--accent)}
.copy{margin-top:36px;padding-top:20px;border-top:1px solid #1d3d34}
.wrap.legal{max-width:808px;padding-top:80px;padding-bottom:90px}
.legal h2{font-size:1.5rem;margin:36px 0 8px}.legal p,.legal li{color:var(--muted)}.legal ul{margin-left:22px}
.caps{display:flex;flex-wrap:wrap;gap:10px;margin-top:22px}.caps span{border:1px solid var(--line);border-radius:999px;padding:6px 14px;font-size:.93rem;background:var(--card)}
.ask{margin-top:56px;background:var(--ink);color:#eaf2ee;border-radius:20px;padding:34px}
.ask h3{font-size:1.5rem;color:var(--accent);margin-bottom:8px}.ask li{margin:8px 0 0 20px;color:var(--soft)}
.tag{font-family:var(--display);font-size:clamp(1.3rem,3vw,2rem);color:var(--accent);margin-top:14px}
.meta{display:flex;flex-wrap:wrap;gap:34px;margin-top:30px}.meta small{display:block;color:var(--soft)}
.trust{margin-top:18px;color:var(--soft);font-size:.95rem;max-width:56ch}
.rule{margin-top:44px;border-left:4px solid var(--accent);background:var(--card);border-radius:0 18px 18px 0;padding:24px 28px}
.rule b{font-family:var(--display);font-size:1.25rem}.rule p{color:var(--muted);margin-top:6px}
.founder{display:flex;gap:22px;align-items:flex-start;margin-top:36px;padding:26px;border:1px solid var(--line);border-radius:20px;background:var(--card)}
.founder h3{font-size:1.5rem}.founder small{color:var(--muted);font-weight:600}.founder p{color:var(--muted);margin-top:8px;max-width:62ch}
.mono{flex:none;width:72px;height:72px;border-radius:50%;background:var(--ink);color:var(--accent);display:grid;place-items:center;font:800 1.5rem var(--display)}
#enquiry{display:grid;gap:14px}#enquiry label{display:grid;gap:6px;font-weight:500;color:var(--ink)}
#enquiry input,#enquiry select,#enquiry textarea{font:inherit;padding:12px 14px;border-radius:12px;border:1.5px solid var(--line);background:#fff;color:var(--ink);width:100%}
#enquiry input:focus,#enquiry select:focus,#enquiry textarea:focus{border-color:var(--ink)}
#enquiry button{justify-self:start;border:0;cursor:pointer;font:inherit;font-weight:600}
.note{color:var(--muted);font-size:.9rem}.note a{text-decoration:underline}
.ask p{color:var(--soft)}
footer{background:var(--deep);color:var(--soft);padding:34px 0;border-top:1px solid #1d3d34;font-size:.93rem}

@media(max-width:820px){
  .grid .card,.card:nth-child(n+4){grid-column:span 6}
  .split,.menu-inner{grid-template-columns:1fr;gap:28px}
  .sec{padding:80px 0}
  .fgrid{grid-template-columns:1fr 1fr}.fgrid>div:first-child{grid-column:1/-1}
  .top{padding:14px 18px}.close{right:18px}
}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important;scroll-behavior:auto!important}.reveal,.w>span{opacity:1;transform:none}.menu li a{transform:none}}
</style>
</head>
<body>
<div class="progress" id="progress"></div>
<header class="top">
  <a href="#" class="logo" id="brand"></a>
  <button class="dots" id="dots" aria-label="Open menu" aria-expanded="false" aria-controls="menu">
    <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true"><circle cx="12" cy="4.5" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="12" cy="19.5" r="2"/></svg>
  </button>
</header>

<div class="menu" id="menu" role="dialog" aria-modal="true" aria-label="Site menu">
  <button class="close" id="closeMenu" aria-label="Close menu">&times;</button>
  <nav class="menu-inner">
    <div><p class="m-label">Explore</p><ul id="mainLinks"></ul></div>
    <div><p class="m-label">Services</p><ul id="svcLinks"></ul></div>
  </nav>
</div>

<main>
  <div id="home">
    <section class="dark hero" id="top">
      <div class="blob b1"></div><div class="blob b2"></div>
      <div class="wrap">
        <p class="eyebrow">Music sync support for independent artists</p>
        <h1 id="heroTitle"></h1>
        <p class="lead" id="heroText"></p>
        <div class="cta"><a class="btn" href="#contact">Request a catalogue review</a><a class="btn ghost" href="#process">How the process works</a></div>
        <p class="trust">No placement guarantees. Clear rights information and written terms before any submission.</p>
        <div class="faces" id="faces" aria-hidden="true"></div>
      </div>
      <div class="marquee" aria-hidden="true"><div id="marquee"></div></div>
    </section>

    <section class="sec" id="features">
      <div class="wrap">
        <h2 class="reveal">Features</h2>
        <p class="lead reveal" style="--d:.1s">Five specialist services, with music sync at the centre. Open any of them to see what you receive and how it works.</p>
        <div class="grid" id="cards"></div>
        <h3 class="reveal" style="margin-top:88px;font-size:2rem">Not sure where to start?</h3>
        <p class="lead reveal">Most engagements begin with a problem rather than a service name. Find the discipline that matches what you are trying to solve.</p>
        <div class="disc" id="disc"></div>
      </div>
    </section>

    <section class="sec dark" id="why">
      <div class="wrap">
        <p class="eyebrow reveal">Why Leading Team</p>
        <h2 class="reveal">Built to be trusted with work that matters.</h2>
        <p class="lead reveal">A company is judged by how it handles the difficult middle of a project. These are the standards we hold to.</p>
        <div class="nlist" id="whyList"></div>
      </div>
    </section>

    <section class="sec" id="process">
      <div class="wrap">
        <p class="eyebrow reveal">Our Process</p>
        <h2 class="reveal">How it works, from first conversation to reporting.</h2>
        <p class="lead reveal">Five stages. Nothing is submitted until you approve it in writing.</p>
        <div class="nlist" id="procList"></div>
        <div class="rule reveal"><b>Artist approval rule</b><p>No track is submitted or represented as cleared for licensing until its rights information has been checked and you have approved the agreed scope in writing. You keep ownership of your recordings and compositions unless a separate written agreement expressly says otherwise.</p></div>
      </div>
    </section>

    <section class="sec dark" id="about">
      <div class="wrap">
        <h2 class="reveal">About us</h2>
        <p class="lead reveal" id="aboutText"></p>
        <div class="facts reveal" id="facts"></div>
        <div class="stats" id="stats"></div>
        <div class="two">
          <div class="reveal"><h3>Who we are</h3><div id="whoText"></div></div>
          <div class="reveal" style="--d:.1s"><h3>Our mission</h3><p id="mission"></p><h3 style="margin-top:28px">Our vision</h3><p id="vision"></p></div>
        </div>
        <h3 class="sub reveal" style="margin-top:72px">Our values</h3>
        <div class="values reveal" id="values"></div>
        <div class="two">
          <div class="reveal"><h3>Our philosophy</h3><p id="philoH" style="color:#eaf2ee;font-size:1.25rem;margin-bottom:12px"></p><div id="philo"></div></div>
          <div class="reveal" style="--d:.1s"><h3>Professional standards</h3><ul class="checks" id="standards" style="margin-top:0"></ul></div>
        </div>
        <h3 class="sub reveal" style="margin-top:72px">How we work with clients</h3>
        <div class="nlist" id="clients"></div>
        <div class="two"><div class="reveal"><h3>Company culture</h3><p id="culture"></p></div></div>
      </div>
    </section>

    <section class="sec" id="position">
      <div class="wrap">
        <h2 class="reveal">Meet the team</h2>
        <p class="lead reveal" style="--d:.1s">Five specialists, each leading one service, under one founder. Select a person to read about their work.</p>
        <div class="founder reveal"><div class="mono" aria-hidden="true">KT</div><div><h3>Kingsley Thomas</h3><small>Founder</small><p>Kingsley Thomas is the founder of Leading Team and leads its work with independent artists on catalogue assessment and sync-readiness. He focuses on helping artists understand where their music may fit, what rights information is needed, and what steps should be agreed before any authorised submission.</p></div></div>
        <div class="team" id="team"></div>
      </div>
    </section>

    <section class="sec dark" id="insights">
      <div class="wrap">
        <h2 class="reveal">Insights</h2>
        <p class="lead reveal">Practical writing from the specialists who do the work. No trend reports, no listicles: what we have learned from actual projects.</p>
        <div class="ins" id="insList"></div>
      </div>
    </section>

    <section class="sec" id="faq">
      <div class="wrap">
        <h2 class="reveal">Frequently asked questions</h2>
        <p class="lead reveal">Straight answers, organised by service.</p>
        <div class="tabs" id="faqTabs" role="group" aria-label="FAQ categories"></div>
        <div id="faqList"></div>
      </div>
    </section>

    <section class="sec dark" id="policy">
      <div class="wrap">
        <h2 class="reveal">Policy</h2>
        <p class="lead reveal" style="--d:.1s">How we work with each other and with our clients.</p>
        <div id="policyList" class="reveal" style="margin-top:36px"></div>
      </div>
    </section>
    <section class="sec" id="contact">
      <div class="wrap split">
        <div><h2 class="reveal">Request a catalogue review</h2><p class="lead reveal">Tell us about your music. We reply with the next step and what to prepare. Nothing is submitted without your written approval.</p></div>
        <form id="enquiry" class="reveal" style="--d:.1s">
          <label>Name<input name="name" required autocomplete="name"></label>
          <label>Artist or project name<input name="artist" required></label>
          <label>Email<input name="email" type="email" required autocomplete="email"></label>
          <label>Main listening link<input name="link" type="url" placeholder="https://"></label>
          <label>What support are you looking for?<select name="support"><option>Catalogue review</option><option>Sync-readiness preparation</option><option>Pitch materials</option><option>Submission support</option><option>Artist guidance</option><option>Website, SEO, video or finance</option></select></label>
          <label>Do you control the master?<select name="master"><option>Yes</option><option>Partly</option><option>No</option><option>Not sure</option></select></label>
          <label>Who controls publishing?<input name="publishing"></label>
          <label>Message (optional)<textarea name="msg" rows="4"></textarea></label>
          <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" style="display:none" aria-hidden="true">
          <button class="btn" type="submit">Send enquiry</button>
          <p class="note" id="formStatus" role="status"></p>
          <p class="note" id="formNote" role="status">We use these details only to reply (see our <a href="#privacy">privacy policy</a>). Please do not send passwords or sensitive data.</p>
        </form>
      </div>
    </section>
  </div>
  <div id="service" hidden></div>
</main>
<footer><div class="wrap"><div class="fgrid" id="fgrid"></div><p class="copy" id="footer"></p></div></footer>

<script>
const PHOTOS = {
  john: "data:image/jpeg;base64,",
  newness: "data:image/jpeg;base64,",
  godswill: "data:image/jpeg;base64,",
  toheeb: "data:image/jpeg;base64,",
  habbeb: "data:image/jpeg;base64,"
};

/* ===== EDIT YOUR CONTENT HERE. The whole site builds itself from this object. ===== */
const SITE = {
  name: "Our Team",
  heroTitle: "Five people, one release pipeline.",
  heroText: "We handle the money, the website, the search ranking, the music rights and the edit, so your project ships without gaps.",
  about: "We are five specialists in finance, web development, search, music licensing and video. We work as one team, so every client project is planned, built, promoted and delivered under one roof, with one point of accountability.",
  mission: "To give creators and businesses a complete production team: money managed properly, a strong web presence, content that gets found, music that is legally cleared, and video that is finished to a professional standard.",
  approach: [
    { t: "Plan", d: "We agree scope, budget and timeline before any work starts." },
    { t: "Build", d: "Each specialist delivers their part, and we review it together." },
    { t: "Release", d: "We launch, license and promote, then report back on results." }
  ],
  values: [
    { t: "Accountability", d: "Every task has one named owner on the team." },
    { t: "Transparency", d: "Costs, rights and timelines are written down and shared." },
    { t: "Craft", d: "We finish work to a standard we would put our own names on." },
    { t: "Respect", d: "We protect our clients' work, data and reputation." }
  ],
  stats: [
    { v: new Date().getFullYear() - 2018, l: "years working together" },
    { v: 5, l: "specialists" },
    { v: 5, l: "disciplines under one roof" }
  ],
  team: [
    { name: "Toheeb", role: "Financial management", photo: PHOTOS.toheeb, bio: "Keeps every project on budget and every payment on time." },
    { name: "Newness", role: "Website development", photo: PHOTOS.newness, bio: "Designs and builds the sites the rest of the team's work lives on." },
    { name: "John Sylvia", role: "SEO expert", photo: PHOTOS.john, bio: "Makes sure people searching for you actually find you." },
    { name: "Godswill", role: "Sync licensing expert", photo: PHOTOS.godswill, bio: "Finds the right track and gets the rights cleared properly." },
    { name: "Habbeb", role: "Video editing expert", photo: PHOTOS.habbeb, bio: "Turns raw footage into something people watch to the end." }
  ],
  policies: [
    { t: "Payment terms", d: "A deposit starts the work and the balance is due on delivery. Invoices are itemised, and we confirm any change in cost before doing the extra work." },
    { t: "Ownership and licensing", d: "You own the final deliverables once paid. Licensed music stays under the terms agreed in your sync licence, and we list those terms in writing." },
    { t: "Communication", d: "Each project has one named lead on our side, and we give you a progress update at every stage." },
    { t: "Revisions", d: "Every package includes two rounds of revisions. Extra rounds are quoted before we start them." },
    { t: "Privacy", d: "We only use your files and data for your project, and we delete them on request when it ends." }
  ],
  services: [
    { id: "finance", title: "Financial management", owner: 0,
      short: "Budgets, royalties and payouts handled clearly, so your music career runs like a business.",
      what: "Financial management for artists means planning, tracking and protecting the money your work earns. It covers budgeting for releases and tours, invoicing, collecting royalties, paying collaborators and setting money aside for tax.",
      why: "Many artists earn well and still struggle, because income arrives unevenly from streams, shows, brand deals and licensing. Without a system, money gets lost, payments are late and splits cause disputes. Good financial management turns unpredictable income into a stable career.",
      benefits: [["Clear budgets","Know what a single, video or tour will cost before you spend."],["Royalty tracking","Every stream, licence fee and show payment is recorded and followed up."],["Fair splits","Producers, writers and features are paid on agreed terms, in writing."],["Tax readiness","Records stay organised, so filing is simple and nothing is missed."]],
      artists: ["Plan a release budget that covers recording, marketing and video.","Get paid on time with professional invoices and clear payment terms.","See every month where your money comes from and where it goes."],
      process: [["Review","We look at your income, costs and goals."],["Budget","We build a plan for each release or project."],["Track","Every payment is recorded and checked."],["Report","You get a monthly summary in plain language."]],
      faq: [["Do I need this if I am just starting out?","Yes. Good habits are cheap to start early, and fixing messy records later costs far more."],["Who holds my money?","Your money stays in your own accounts. We plan, track and advise, and payments follow terms you approve."]] },
    { id: "web", title: "Website development", owner: 1,
      short: "A fast, professional home on the internet that you own, built for fans and industry alike.",
      what: "Website development is designing and building the site that represents you online. For an artist that usually means a home page, music and video, tour dates, a press kit, a store and a way to join your mailing list, all on an address you control.",
      why: "Social platforms and streaming services change their rules and algorithms without warning. Your own website is the one place where your brand, your audience and your story stay in your hands, and it is the first place promoters, labels and music supervisors look.",
      benefits: [["Ownership","Your content and fan list belong to you, not to a platform."],["Credibility","A professional site shows promoters and brands that you are serious."],["Direct sales","Sell music, merchandise and tickets without giving large cuts away."],["Speed and mobile","Pages load fast and look right on every phone."]],
      artists: ["An electronic press kit with bio, photos and links, ready to send.","Email sign-up to build a fan list you can reach at any time.","Easy updates for new releases, shows and news."],
      process: [["Discover","We learn your brand, goals and audience."],["Design","You approve the look and layout first."],["Build","We code it fast, secure and mobile-ready."],["Launch","We publish, test and stay on hand for changes."]],
      faq: [["Can I update the site myself?","Yes. We build it so common changes like new releases and dates are simple, and we help when you need more."],["Do I need to buy a domain?","A custom address such as yourname.com looks more credible and we can guide you, but a free address works while you start."]] },
    { id: "seo", title: "SEO", owner: 2,
      short: "Make sure people searching for you, your music or your services actually find you.",
      what: "SEO, or search engine optimisation, is the practice of improving your website and online profiles so they appear higher in results on Google and other search engines. It combines the right keywords, quality content, technical site health and trusted links from other sites.",
      why: "When someone hears a song, sees a clip or gets recommended an artist, the next step is usually a search. If your name, lyrics, releases or events do not show up properly, that fan, journalist or booker moves on to someone who does.",
      benefits: [["More discovery","Appear when people search for your name, songs and genre."],["Free, lasting traffic","Unlike ads, good rankings keep bringing visitors without a cost per click."],["Trust","Top results are seen as more credible by listeners and the industry."],["Measurable growth","Analytics show what people search, click and buy."]],
      artists: ["Rank for your name, song titles and lyrics so fans land on your official pages.","Get event and release pages shown clearly in search results.","Connect your site, Spotify, YouTube and socials so search engines recognise you as one artist."],
      process: [["Audit","We check your site and profiles for problems."],["Research","We find the words your fans really search."],["Optimise","We improve pages, content and links."],["Measure","We track rankings and report what changed."]],
      faq: [["How long does SEO take?","Most sites see early movement in a few weeks and steady results over three to six months, because search engines build trust gradually."],["Is SEO only for websites?","No. YouTube, streaming profiles and social pages can be improved too, using titles, descriptions and links."]] },
    { id: "sync", title: "Sync licensing", owner: 3,
      short: "Place your music in film, TV, ads, games and online video, and get paid for it.",
      what: "Synchronisation, or sync, licensing is the permission a rights holder gives to use music alongside moving images, such as a film, TV show, advert, video game or online video. A sync licence covers the use of both the recording and the underlying song.",
      why: "Sync pays an upfront fee for each placement, can bring performance royalties when the work is broadcast, and puts your music in front of audiences far beyond streaming. One placement can raise an artist's profile and income at the same time.",
      benefits: [["Upfront fees","You are paid for each licence, often before the work is released."],["Ongoing royalties","Broadcast and public performance can earn more over time."],["New audiences","Viewers discover you through scenes, adverts and games."],["Lasting catalogue value","Well-organised music can be licensed again and again."]],
      artists: ["Get tracks prepared with correct metadata, splits and instrumentals, which supervisors expect.","Have rights cleared properly so a placement never falls through.","Be pitched to music supervisors and brands who are actively searching."],
      process: [["Catalogue review","We select the tracks with the best sync potential."],["Rights check","We confirm who owns the recording and the song."],["Pitch","We present your music for real briefs."],["Clear and report","We agree terms, clear rights and track payments."]],
      faq: [["Do I need to own all my rights?","You need the right to license both the recording and the composition. If others co-own it, we help get their agreement in writing first."],["Will licensing stop me releasing the song?","Usually not. Most sync deals are non-exclusive, and we explain the terms of each deal before you sign."]] },
    { id: "video", title: "Video editing", owner: 4,
      short: "Music videos, lyric videos and short clips cut with the pace and polish that keep people watching.",
      what: "Video editing is shaping raw footage into a finished piece through cutting, pacing, colour, sound and motion graphics. For artists it covers music videos, lyric videos, visualisers, behind-the-scenes content and the short vertical clips that drive discovery on social platforms.",
      why: "Video is now how most people discover music. Strong visuals make a song memorable, help it travel on social media and YouTube, and give brands and supervisors a clear picture of who you are as an artist.",
      benefits: [["Stronger identity","A consistent look and feel makes you recognisable."],["Platform-ready formats","Edits made for YouTube, Reels, TikTok and Shorts."],["More reach","Short clips travel further than a link to a song."],["Efficient content","One shoot becomes a full video, teasers and clips."]],
      artists: ["Turn one shoot into a music video, teasers and short clips.","Make lyric videos and visualisers for songs without a full video budget.","Have colour and sound polished so you look and sound professional."],
      process: [["Brief","We agree the story, style and formats."],["Edit","We cut, grade and add sound and graphics."],["Review","You give feedback within your revision rounds."],["Deliver","You get final files for every platform."]],
      faq: [["How many revisions do I get?","Every project includes two rounds of revisions. Extra rounds are quoted before we start them."],["Can you work with footage I already have?","Yes. Send what you have and we will advise on what can be made from it."]] }
  ]
};


/* ===== Content from the Leading Team company site ===== */
Object.assign(SITE, {
  name: "Leading Team",
  heroTitle: "Your music. Prepared for the screen.",
  heroText: "Leading Team works with independent artists to assess song catalogues, identify potential sync fits and prepare music for consideration by relevant film, television, advertising and production opportunities.",
  about: "Leading Team is a multidisciplinary company bringing together digital development, search optimisation, financial management, visual storytelling and music licensing expertise.",
  facts: [["Focus","Music sync, led by specialists"],["Disciplines","Five, specialist-led"],["Structure","One coordinated team"],["Engagement","International, remote-first"]],
  who: ["We combine specialised skills and collaborative thinking to help our clients build stronger digital identities and access new creative opportunities.","The company exists because digital work rarely succeeds in isolation. A website that ignores search is expensive to maintain. A film that ignores its platform is never watched. A catalogue without documentation cannot be licensed, however good the music is. Our structure puts those disciplines next to each other on purpose.","Each area of the business is led by a named specialist who is responsible for it. The person who does the work is the person who answers for it, and the person a client speaks to when it matters."],
  mission: "To help businesses and creative professionals move forward with digital work that is considered, well built and honestly reported.",
  vision: "To be a company whose disciplines are trusted together: where a client can bring a website, a search problem, a film or a catalogue and receive the same standard of attention.",
  values: [{t:"Precision",d:"Clear scope, defined deliverables, and work that holds up to inspection."},{t:"Candour",d:"We say what the work needs, including when the answer is less than the client hoped for."},{t:"Coordination",d:"Specialists working towards one objective, not separate conversations."},{t:"Craft",d:"Details are the work. Type, pacing, structure and code are not decoration."},{t:"Accountability",d:"Decisions and deadlines are documented, and we own what we committed to."}],
  philoH: "Good digital work is an argument made carefully: the right structure, the right words, the right image, in the right order.",
  philo: ["We are sceptical of work that looks impressive in isolation and does nothing for the person using it. A page that cannot be read on a phone, a film that loses its audience in the first ten seconds, or a catalogue that cannot be cleared has failed regardless of how it was presented internally.","So we test against the person on the other side: the customer deciding whether to trust a company, the supervisor deciding whether a track fits, the reader deciding whether to keep going."],
  standards: ["Work is reviewed internally before it reaches a client.","Files, access and documentation are organised at handover.","Client information is treated as confidential.","We do not claim results we cannot evidence.","Recommendations are made in the client's interest, not ours."],
  clients: [["We start with the objective","Before a deliverable is proposed, we agree what the work is meant to achieve and how it will be judged."],["One point of contact","A single person coordinates the engagement, even when several specialists are involved."],["Written scope before production","Deliverables, timeline and cost are agreed in writing before any production work begins."],["Honest reporting","If something changes, slips or turns out to be the wrong approach, we say so early."]],
  culture: "We work in writing, keep decisions where everyone can find them, and give each specialist the room to do their discipline properly. Projects are planned in stages, reviewed before delivery, and closed with a handover rather than a final message. That structure lets a distributed team work on one engagement without the client having to manage the coordination.",
  why: [["No guarantees","We do not promise placements, income, supervisor replies or timelines. Placement depends on fit, timing, rights, budgets and third parties."],["Rights checked first","Ownership of masters, publishing, splits and samples is confirmed before any track is put forward."],["Written approval","You approve the tracks and scope in writing before anything is submitted."],["A record of every submission","You are told what was sent, to whom, and what happened next."],["Your rights stay yours","Ownership stays with you unless a separate written agreement says otherwise."]],
  proc: [["Introductory conversation","We learn about you, your catalogue, goals and rights situation. You receive: a clear scope, and you share only what is needed."],["Catalogue assessment","We review the recordings and available song and rights information. You receive: a written shortlist with honest fit notes."],["Readiness checks","We identify missing versions, metadata, splits, registrations or permissions. You approve: the facts, and supply anything missing."],["Written approval","We agree the exact tracks, submission scope and terms. You approve: in writing, before any submission."],["Targeted submissions and reporting","Only where authorised, we submit and track activity. You receive: updates and next steps. No placement is promised."]],
  disc: [["I need a professional website","Corporate sites, portfolios and e-commerce builds.","web"],["I want better search visibility","Audits, technical foundations and organic growth.","seo"],["I need compelling visual content","Promotional, corporate and social video.","video"],["I want to license music for a production","Catalogue evaluation and placement coordination.","sync"],["I need my money organised","Budgets, invoicing, royalties and payouts.","finance"]],
  insights: [["Website Development","What a Website Should Prove in the First Five Seconds","Most visitors decide whether to keep reading before they reach the second screen. Here is what the first view of a site has to answer.","Newness · November 18, 2026 · 4 min read"],["SEO & Digital Growth","Technical Foundations Before Content","Publishing more pages onto a broken structure rarely improves visibility. The order of the work matters more than the volume of it.","5 min read"],["Music Licensing","How Sync Licensing Actually Works","A plain explanation of what sync licensing involves, who the parties are, and what a catalogue needs before it can be considered.","5 min read"],["Video Production","Editing for Attention, Not for Effect","Transitions do not hold an audience. Structure does. A short note on how we approach the cut.","4 min read"]]
});
const EXTRA = {
  finance: { tag: "Money managed clearly, from first budget to final payout.", intro: "Good money habits are part of a creative career. We plan budgets, track income and keep every payment documented, so decisions are made on facts.", caps: ["Release and project budgeting","Invoicing and payment tracking","Royalty and income tracking","Collaborator payouts and splits","Tax-ready record keeping","Monthly financial reporting"], ask: ["Your income sources and current records","Upcoming releases, shows or projects to budget","Who needs to be paid, and on what terms","Reporting dates and tax deadlines"] },
  web: { tag: "Building digital experiences that move businesses forward.", intro: "A website is the clearest statement a business makes about itself. We design and build sites that load quickly, read clearly, work flawlessly on every screen, and give the people behind them room to grow.", caps: ["Business website development","Corporate website design","Portfolio websites","E-commerce website development","Responsive website experiences","Website maintenance and improvements"], ask: ["What the website needs to accomplish","Who it speaks to, and what they need to find","The content, pages and features already in place","Timelines, approvals and who signs off"] },
  seo: { tag: "Make your business easier to find.", intro: "Search visibility is earned through structure, relevance and patience. We work through the technical foundations first, then the content, so improvements compound instead of fading.", caps: ["SEO audits","Keyword research","On-page SEO","Technical SEO","Content optimisation","Search visibility strategy","Organic growth"], ask: ["Your current site and the pages that matter most","The searches you want to be found for","Any previous SEO work or penalties to account for","Who maintains the site and its content"] },
  sync: { tag: "Connecting great music with the right visual moments.", intro: "Sync licensing is the process of matching recorded music to picture under a formal agreement. We evaluate catalogues, prepare them for consideration, and coordinate between artists, rights holders and the productions that need them.", caps: ["Catalogue review","Sync-readiness preparation","Pitch materials","Submission support, only where you authorise it","Artist guidance on rights, PROs and approvals"], ask: ["The catalogue: recordings, writers and ownership splits","Whether masters and publishing are controlled or representable","Any existing samples, features or encumbrances","Your goals for the catalogue and any deadlines"] },
  video: { tag: "Turn your footage into powerful visual stories.", intro: "Good editing is invisible. We take the footage a client already has, find the story inside it, and build a cut that holds attention from the first frame to the last.", caps: ["Promotional video editing","Social media video content","Corporate videos","Brand storytelling","Short-form content","Commercial video production editing"], ask: ["The footage, formats and assets available","Where the finished video will be published","The message the audience should leave with","Runtime, aspect ratios and delivery dates"] }
};
SITE.services.forEach(x => Object.assign(x, EXTRA[x.id]));
const MORE = {
 finance: { limits: "We do not act as your accountant or tax adviser, and we do not hold your funds. We cannot guarantee income. Tax and legal questions are referred to a qualified professional.",
  process: [["Review","We look at your income, costs and goals. You receive: a short summary of where you stand."],["Budget","We build a plan for each release or project. You approve: the budget before spending starts."],["Track","Payments and costs are recorded and checked. You receive: an up-to-date record."],["Report","You receive a monthly summary in plain language, with next steps."]] },
 web: { limits: "We do not guarantee traffic, sales or search rankings. Hosting, domains and payment providers are third-party services with their own terms.",
  process: [["Discover","We learn your brand, goals and audience. You receive: a written scope and page list."],["Design","You approve: the look and layout before anything is built."],["Build","We code it fast, secure and mobile-ready. You receive: a working preview to review."],["Launch","We publish and test. You receive: the live site, your files and a handover note."]] },
 seo: { limits: "We do not guarantee rankings, traffic or timing. Search engines make the final decisions, and results depend on competitors and algorithm changes.",
  process: [["Audit","We check your site and profiles. You receive: a prioritised list of issues."],["Research","We find the words your audience really searches. You receive: target search terms."],["Optimise","We improve pages, content and links. You approve: changes before they go live."],["Measure","We track what changed. You receive: a plain report with next steps."]],
  faq: [["How long does SEO take?","Search engines build trust gradually. Technical fixes can show an effect soon after pages are recrawled, while content and authority work usually takes months. We set expectations per project and cannot promise a date."],["Is SEO only for websites?","No. YouTube, streaming profiles and social pages can be improved too, using titles, descriptions and links."]] },
 video: { limits: "We cannot guarantee views, reach or platform performance. Revisions beyond the agreed rounds are quoted first, and we will not deliver a cut that relies on unlicensed music.",
  process: [["Brief","We agree the story, style and formats. You approve: the brief before editing starts."],["Edit","We cut, grade and add sound and graphics. You receive: a first cut for review."],["Review","You give consolidated feedback within the agreed revision rounds."],["Deliver","You receive: final files for every platform you named."]] },
 sync: { short: "Prepare your catalogue and explore suitable sync opportunities in film, TV, advertising, games and online video.",
  limits: "We cannot guarantee placements, income, supervisor replies or a timeline. Nothing is submitted without your written approval.",
  artists: ["Get tracks prepared with correct metadata, splits and instrumentals, which supervisors often expect.","Have rights information checked before any track is put forward.","Have suitable tracks submitted only where there is a genuine fit and you have approved it in writing."],
  process: [["Conversation","We learn your goals and rights situation. You receive: a clear scope."],["Assessment","We review your catalogue. You receive: a written shortlist with honest fit notes."],["Readiness checks","We find missing versions, metadata or splits. You approve: the facts."],["Written approval","We agree tracks and scope. Nothing is submitted before you approve in writing."],["Submissions and reporting","Only where authorised. You receive: a record of what was sent and next steps."]] }
};
SITE.services.forEach(x => Object.assign(x, MORE[x.id]));
const FAQS = {
 "General": [["What kind of company is Leading Team?","We are a multidisciplinary company working across website development, SEO, video editing, sync licensing and financial management. Each discipline is led by a specialist, and work that involves more than one service is coordinated as a single engagement."],["How do I start a project?","Tell us what you are trying to achieve and any deadlines you are working to. We respond with the next step, usually a short conversation before any scope is written."],["Do you work with clients outside your own country?","Yes. Our work is delivered remotely and we are set up to coordinate across time zones. Communication is written wherever possible so decisions are documented for everyone involved."],["Can I request more than one service at once?","Yes, and it is often the better approach. A website build and its search foundations, for example, are more effective planned together than in sequence."],["How is work priced?","Each engagement is quoted individually after we understand the scope. We provide a written scope, timeline and estimate before work begins, and we do not start production on an unclear brief."],["How is my information handled?","Details you send us are used only to respond to your request and are not sold or shared. Our privacy policy explains this in full."]],
 "Website Development": [["What do you need from me to quote a website?","The purpose of the site, who it is for, the pages or sections you expect, any content you already have, and your timeline. If an existing site is being replaced, access to it helps us understand what should be kept."],["Can you improve an existing website instead of rebuilding it?","Often, yes. If the foundations are sound, targeted improvements to structure, performance and content can be the more sensible route. We will tell you honestly when a rebuild is the better decision."],["Will the site work on phones and tablets?","Every site we deliver is built and tested responsively. Layouts are designed for small screens first, then extended, rather than compressed from a desktop design."],["Who owns the website after delivery?","You do. We hand over the files, access and documentation you need to run and update the site, and we explain what each part does at handover."],["Do you maintain sites after launch?","We offer ongoing maintenance and improvement work, covering updates, small content changes, performance checks and technical fixes, agreed as a defined arrangement rather than an open-ended retainer."]],
 "SEO": [["How long does SEO take to show results?","Search visibility changes gradually. Technical corrections can take effect relatively quickly once pages are recrawled, while content and authority improvements usually take months. We set expectations per project rather than promising a date."],["Do you guarantee first-page rankings?","No, and no responsible practitioner can. Search results depend on factors outside any agency's control, including competitors and algorithm changes. What we commit to is a clear diagnosis, prioritised work and honest reporting."],["What is included in an SEO audit?","A crawl of the site, a review of indexation and site structure, page-level metadata and content assessment, performance checks, and a prioritised list of issues with recommended fixes."],["Can you work on a site built by another developer?","Yes. Where a fix requires development access or a change to the codebase, we will say so clearly and coordinate with whoever maintains it."],["Do you write the content as well?","We can optimise existing content and advise on structure and briefs. Where new content is needed, we agree who is writing it before the work starts."]],
 "Video Editing": [["What footage do you need from me?","The original files rather than compressed exports, ideally with any separate audio. If footage is still to be shot, we can advise on what to capture for the edit you have in mind."],["How many revisions are included?","The number of review rounds is agreed in the scope before editing begins. We ask for consolidated feedback per round so revisions stay focused and the project keeps moving."],["Can you deliver vertical versions for social platforms?","Yes. We can deliver the same story in multiple aspect ratios and runtimes, cut properly for each placement rather than simply cropped."],["Do you supply the music?","We can work with music you have licensed, or advise on options. Any commercial track used in published work needs a licence, and we will not deliver a cut that relies on unlicensed music."],["How long does an edit take?","It depends on footage volume, runtime and the number of review rounds, so we give a timeline with the quote."]],
 "Sync Licensing": [["What is sync licensing?","Sync licensing is permission to use music in timed visual media such as film, television, advertising, games or online video. It is agreed between the rights holder and the production using the music."],["Do you guarantee that my music will be placed?","No. Placements depend on creative fit, timing, rights, budgets and decisions made by third parties. We do not promise placements, income, replies or timelines."],["Do I keep ownership of my masters and compositions?","Yes. You keep ownership unless a separate written agreement expressly says otherwise."],["Do I need to be registered with a PRO?","A Performing Rights Organisation registration is usually needed to collect performance royalties. What applies to you depends on your territory and contracts, so we explain your position before pitching."],["What is the difference between master and publishing rights?","The master is the recording; publishing covers the composition and lyrics. A sync licence normally needs both, so we check who controls each."],["Do you need clean, instrumental or alternate versions?","Where available, yes. Supervisors often ask for them, and we list what is missing during readiness checks."],["Will you submit my music without my approval?","Never. No track is submitted until rights have been checked and you have approved the tracks and scope in writing."],["Which companies or supervisors do you contact?","Only relevant ones where there is a genuine fit, within the scope you approve. You receive a record of what was sent."],["How will I receive updates?","You receive written updates on submissions, responses and next steps."],["Can I work with other representatives or submit music myself?","That depends on your agreements and on the scope we agree, so we confirm it in writing before any submission."]]
};
FAQS["Financial Management"] = [["Do you hold or move my money?","No. Your money stays in your own accounts. We plan, track and report, and payments follow terms you approve."],["Are you my accountant?","No. We organise your records and report clearly. For tax filing and tax or legal advice, you should use a qualified professional, and we keep your records ready for them."],["What do you need to get started?","Your income sources, current records, upcoming projects, and who needs to be paid and on what terms."],["Do you guarantee I will earn more?","No. We cannot promise income. We help you see where money comes from and goes, so decisions are made on facts."]];
const LEGAL = {
 privacy: { title: "Privacy Policy", intro: "A plain description of what this website collects and why.", s: [["Overview","This policy explains what information is collected when you use this website or contact us, why it is collected, and how it is handled."],["Information we collect","We only collect the information you choose to send us when you get in touch: your name and contact details, your company and country if you provide them, and the details of your project and goals."],["How the information is used","Details you send are used to review your request, route it to the specialist responsible for that discipline, and respond to you. They are not sold, rented or used for unrelated marketing."],["Storage and access","Information is accessible only to the team members who need it to respond. It is kept for as long as necessary to handle your request and any resulting work, after which it may be deleted."],["Sharing","We do not share your details with third parties for their own purposes. Where a service provider is used to host the site or store data, access is limited to what is required to operate the service."],["Cookies and analytics","This website does not set advertising or profiling cookies. Any storage used is limited to what is needed for the site to function correctly."],["Your choices","You can ask us to confirm what information we hold about you, to correct it, or to delete it, and we will respond within a reasonable period."],["Changes to this policy","This policy may be updated as the business and its processes change. The revision date at the top of this page shows when it was last reviewed."]] },
 terms: { title: "Terms of Service", intro: "The basis on which this website is provided.", s: [["Use of this website","This website is provided for information about Leading Team and its services. By using it, you agree to use it lawfully and not to interfere with its operation or security."],["Service information","Descriptions of services on this website are general. The specific deliverables, timeline and cost of any engagement are agreed separately in writing before work begins."],["Enquiries and proposals","Sending an enquiry or project brief does not create a contract or oblige either party to proceed. A project begins only when a written scope has been agreed by both sides."],["No guarantee of results","Search visibility, licensing placements and audience outcomes depend on factors outside our control. We describe our approach honestly and do not promise specific rankings, placements or earnings."],["Intellectual property","The text, layout and visual material on this website belong to Leading Team unless stated otherwise. You may not reproduce it for commercial use without permission. Ownership of work produced for a client is set out in the relevant project agreement."],["Third-party links","Where this website links to another site, that site is governed by its own terms. We are not responsible for its content or practices."],["Limitation of liability","This website is provided on an as-is basis. To the extent permitted by law, we are not liable for loss arising from reliance on general information published here rather than on a written agreement."],["Changes to these terms","These terms may be updated from time to time. The revision date at the top of this page shows when they were last reviewed."]] }
};

const HOME_TITLE = 'Leading Team | Music Sync Licensing Support for Independent Artists';
SITE.policies.push({t:"Authority to submit",d:"We submit music only where you have authorised it in writing, for the tracks, territories, media and period you approve."},{t:"Rights and ownership",d:"You keep ownership of your recordings and compositions unless a separate written agreement expressly says otherwise. We check rights information before any track is put forward."},{t:"Reporting",d:"You receive a written record of what was submitted, to whom, and any response."},{t:"Ending the arrangement",d:"Either side can end the arrangement in writing. We confirm what happens to pending submissions at that point."});
LEGAL.terms.s.push(["Submissions and authority","No track is submitted for consideration without your written approval of the tracks and scope."],["Rights and ownership","You keep ownership of your music unless a separate written agreement expressly says otherwise."]);
/* ===== Helpers ===== */
const $ = (s, r = document) => r.querySelector(s);
const $$ = (s, r = document) => [...r.querySelectorAll(s)];
const pad = i => String(i + 1).padStart(2, '0');
const faq = list => list.map(([q, a]) => `<details><summary>${q}</summary><p>${a}</p></details>`).join('');

/* ===== Home ===== */
document.title = HOME_TITLE;
$('#brand').textContent = SITE.name;
$('#footer').textContent = `© 2018–${new Date().getFullYear()} ${SITE.name}. All rights reserved.`;
$('#heroTitle').innerHTML = SITE.heroTitle.split(' ').map((w, i) => `<span class="w"><span style="--i:${i}">${w}</span></span> `).join('');
$('#heroText').textContent = SITE.heroText;
$('#faces').innerHTML = SITE.team.map(m => `<img src="${m.photo}" alt="">`).join('');
const names = SITE.services.map(s => `<span>${s.title}</span>`).join('');
$('#marquee').innerHTML = names + names + names + names;
$('#cards').innerHTML = SITE.services.map((s, i) => `
  <a class="card reveal" href="#${s.id}" style="--d:${i * .08}s">
    <span class="n">${pad(i)}</span>
    <h3>${s.title}</h3><p>${s.short}</p>
    <span class="more">Learn more <i>&rarr;</i></span>
  </a>`).join('');
$('#aboutText').textContent = SITE.about;
$('#facts').innerHTML = SITE.facts.map(([k, v]) => `<div><small>${k}</small><b>${v}</b></div>`).join('');
$('#whoText').innerHTML = SITE.who.map(p => `<p style="margin-bottom:14px">${p}</p>`).join('');
$('#vision').textContent = SITE.vision;
$('#philoH').textContent = SITE.philoH;
$('#philo').innerHTML = SITE.philo.map(p => `<p style="margin-bottom:14px">${p}</p>`).join('');
$('#standards').innerHTML = SITE.standards.map(x => `<li>${x}</li>`).join('');
$('#clients').innerHTML = SITE.clients.map(([t, d], i) => `<div class="nitem reveal" style="--d:${i * .08}s"><b>${pad(i)}</b><h3>${t}</h3><p>${d}</p></div>`).join('');
$('#culture').textContent = SITE.culture;
$('#whyList').innerHTML = SITE.why.map(([t, d], i) => `<div class="nitem reveal" style="--d:${i * .08}s"><b>${pad(i)}</b><h3>${t}</h3><p>${d}</p></div>`).join('');
$('#procList').innerHTML = SITE.proc.map(([t, d], i) => `<div class="nitem reveal" style="--d:${i * .08}s"><b>${pad(i)}</b><h3>${t}</h3><p>${d}</p></div>`).join('');
$('#disc').innerHTML = SITE.disc.map(([t, d, id]) => `<a class="reveal" href="#${id}"><b>${t}</b><span>${d}</span><small>${SITE.services.find(x => x.id === id).title} &rarr;</small></a>`).join('');
$('#insList').innerHTML = SITE.insights.map(([c, t, d, m], i) => `<article class="art reveal" style="--d:${i * .08}s"><small>${c}</small><h3>${t}</h3><p>${d}</p><em>${m}</em></article>`).join('');
$('#fgrid').innerHTML = `<div><b style="font-family:var(--display);font-size:1.4rem;color:#eaf2ee">${SITE.name}</b><p style="margin-top:10px;max-width:38ch">A multidisciplinary company bringing together digital development, search optimisation, visual storytelling, music licensing and financial management.</p></div>
  <div><h4>Company</h4><ul><li><a href="#about">About us</a></li><li><a href="#position">Our team</a></li><li><a href="#insights">Insights</a></li><li><a href="#faq">FAQ</a></li><li><a href="#contact">Contact</a></li></ul></div>
  <div><h4>Services</h4><ul>${SITE.services.map(x => `<li><a href="#${x.id}">${x.title}</a></li>`).join('')}</ul></div>
  <div><h4>Legal</h4><ul><li><a href="#privacy">Privacy policy</a></li><li><a href="#terms">Terms of service</a></li><li><a href="#policy">Working policy</a></li></ul></div>`;
const tabsEl = $('#faqTabs');
tabsEl.innerHTML = Object.keys(FAQS).map(k => `<button class="tab" data-k="${k}" aria-pressed="false">${k}</button>`).join('');
function showFaq(k) { $('#faqList').innerHTML = faq(FAQS[k]); $$('.tab').forEach(t => t.setAttribute('aria-pressed', t.dataset.k === k)); }
tabsEl.addEventListener('click', e => { const b = e.target.closest('.tab'); if (b) showFaq(b.dataset.k); });
showFaq('General');
const legalHTML = L => `<section class="dark s-hero"><div class="wrap"><a class="back" href="#">&larr; Home</a><p class="eyebrow">Legal</p><h1>${L.title}</h1><p class="lead" style="margin-top:20px">Last updated November 2026. ${L.intro}</p></div></section><section class="sec"><div class="wrap legal">${L.s.map(([h, p]) => `<h2>${h}</h2><p>${p}</p>`).join('')}</div></section>`;
$('#mission').textContent = SITE.mission;
$('#stats').innerHTML = SITE.stats.map(s => `<div class="reveal"><b class="num" data-to="${s.v}">0</b><span>${s.l}</span></div>`).join('');
$('#values').innerHTML = SITE.values.map(v => `<div><b>${v.t}</b><span>${v.d}</span></div>`).join('');
$('#team').innerHTML = SITE.team.map((m, i) => `
  <a class="person reveal" href="#${SITE.services[i].id}" style="--d:${i * .08}s">
    <img src="${m.photo}" alt="Portrait of ${m.name}">
    <div class="info"><h3>${m.name}</h3><small>${m.role}</small><p>${m.bio}</p></div>
  </a>`).join('');
$('#policyList').innerHTML = SITE.policies.map((p, i) => `<details${i === 0 ? ' open' : ''}><summary>${p.t}</summary><p>${p.d}</p></details>`).join('');

/* ===== Contact form ===== */
const FORM_URL = 'https://formspree.io/f/xljbkjjj';
$('#enquiry').addEventListener('submit', async e => {
  e.preventDefault();
  const form = e.target, status = $('#formStatus'), btn = $('button', form);
  btn.disabled = true; status.textContent = 'Sending…';
  try {
    const r = await fetch(FORM_URL, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
    if (!r.ok) throw new Error('failed');
    form.reset(); status.textContent = 'Thank you. Your enquiry has been sent and we will reply soon.';
  } catch (err) { status.textContent = 'Sorry, your enquiry could not be sent. Please try again in a moment.'; }
  btn.disabled = false;
});
/* ===== Popup menu (three dots) ===== */
const sections = ['features', 'process', 'about', 'position', 'insights', 'faq', 'policy', 'contact'];
const LABELS = {position:'Meet the team', faq:'FAQ', process:'How it works'};
$('#mainLinks').innerHTML = sections.map((id, i) => `<li><a href="#${id}" style="--i:${i}">${LABELS[id] || id[0].toUpperCase() + id.slice(1)}</a></li>`).join('');
$('#svcLinks').innerHTML = SITE.services.map((s, i) => `<li><a href="#${s.id}" style="--i:${i + 2}">${s.title}</a></li>`).join('');
const menu = $('#menu'), dots = $('#dots');
function setMenu(open) {
  menu.classList.toggle('open', open);
  dots.setAttribute('aria-expanded', open);
  document.body.style.overflow = open ? 'hidden' : '';
  if (open) $('#closeMenu').focus(); else if (document.activeElement && menu.contains(document.activeElement)) dots.focus();
}
dots.addEventListener('click', () => setMenu(true));
$('#closeMenu').addEventListener('click', () => setMenu(false));
menu.addEventListener('click', e => { if (e.target.closest('a')) setMenu(false); });
document.addEventListener('keydown', e => { if (e.key === 'Escape') setMenu(false); });

/* ===== Service pages ===== */
function svcHTML(s) {
  const i = SITE.services.indexOf(s), o = SITE.team[s.owner];
  const others = SITE.services.filter(x => x !== s).map(x => `<a href="#${x.id}">${x.title}</a>`).join('');
  return `
  <section class="dark s-hero"><div class="wrap">
    <a class="back" href="#features">&larr; All features</a>
    <p class="n reveal">${pad(i)}</p>
    <h1 class="reveal" style="--d:.1s">${s.title}</h1>
    <p class="tag reveal" style="--d:.15s">${s.tag}</p>
    <p class="lead reveal" style="--d:.2s;margin-top:16px">${s.intro}</p>
    <div class="owner reveal" style="--d:.3s"><img src="${o.photo}" alt=""><span>Led by <b>${o.name}</b><br>${o.role}</span></div>
    <div class="meta reveal" style="--d:.4s"><div><small>Discipline</small>${s.title}</div><div><small>Engagement</small>Project-based, scoped in writing</div></div>
  </div></section>
  <section class="sec"><div class="wrap split"><h2 class="reveal">What is ${s.title}?</h2><div class="reveal" style="--d:.1s"><p>${s.what}</p><h3 style="font-size:1.3rem;margin-top:30px">What this service covers</h3><div class="caps">${s.caps.map(c => `<span>${c}</span>`).join('')}</div></div></div></section>
  <section class="sec dark"><div class="wrap split"><h2 class="reveal">Why it matters</h2><p class="reveal" style="--d:.1s">${s.why}</p></div></section>
  <section class="sec"><div class="wrap"><h2 class="reveal">The benefits</h2>
    <div class="bgrid">${s.benefits.map(([t, d], k) => `<div class="bcard reveal" style="--d:${k * .08}s"><h3>${t}</h3><p>${d}</p></div>`).join('')}</div></div></section>
  <section class="sec dark"><div class="wrap"><h2 class="reveal">How it helps artists</h2>
    <ul class="checks">${s.artists.map((a, k) => `<li class="reveal" style="--d:${k * .1}s">${a}</li>`).join('')}</ul></div></section>
  <section class="sec"><div class="wrap"><h2 class="reveal">How we do it</h2>
    <div class="psteps">${s.process.map(([t, d], k) => `<div class="pstep reveal" style="--d:${k * .1}s"><b>${k + 1}</b><h3>${t}</h3><p>${d}</p></div>`).join('')}</div><div class="ask reveal"><h3>Before we quote</h3><p>What we ask for at the start.</p><ul>${s.ask.map(a => `<li>${a}</li>`).join('')}</ul><h3 style="margin-top:28px">What we do not promise</h3><p>${s.limits}</p></div></div></section>
  <section class="sec dark"><div class="wrap"><h2 class="reveal">Common questions</h2>
    <div class="reveal">${faq(s.faq)}</div>
    <h3 class="sub" style="margin-top:72px">Explore our other services</h3><div class="chips">${others}</div></div></section>`;
}

/* ===== Router ===== */
const home = $('#home'), service = $('#service');
function route() {
  const id = location.hash.slice(1), s = SITE.services.find(x => x.id === id), L = LEGAL[id];
  if (s || L) {
    home.hidden = true; service.hidden = false;
    service.innerHTML = s ? svcHTML(s) : legalHTML(L);
    document.title = `${(s || L).title} | ${SITE.name}`;
    window.scrollTo(0, 0);
  } else {
    service.hidden = true; home.hidden = false;
    document.title = HOME_TITLE;
    const el = id && document.getElementById(id);
    el ? el.scrollIntoView() : window.scrollTo(0, 0);
  }
  observe();
}
window.addEventListener('hashchange', route);

/* ===== Scroll effects ===== */
function count(el) {
  const to = +el.dataset.to, t0 = performance.now();
  (function tick(t) {
    const p = Math.min((t - t0) / 1400, 1);
    el.textContent = Math.round(to * (1 - Math.pow(1 - p, 3)));
    if (p < 1) requestAnimationFrame(tick);
  })(t0);
}
const io = new IntersectionObserver(es => es.forEach(e => {
  if (!e.isIntersecting) return;
  e.target.classList.add('in'); io.unobserve(e.target);
  $$('.num', e.target).forEach(count);
}), { threshold: .12 });
function observe() { $$('.reveal:not(.in)').forEach(el => io.observe(el)); }
const bar = $('#progress'), b1 = $('.b1'), b2 = $('.b2');
window.addEventListener('scroll', () => {
  const y = scrollY, max = document.documentElement.scrollHeight - innerHeight;
  bar.style.width = (max > 0 ? y / max * 100 : 0) + '%';
  b1.style.translate = `0 ${y * .18}px`; b2.style.translate = `0 ${y * -.12}px`;
}, { passive: true });
route();
</script>
</body>
</html>
